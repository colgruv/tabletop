{
  "name": "tabletop",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "client",
    "infra"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm:dev -w server\" \"npm:dev -w client\"",
    "build": "npm run build -w client",
    "test": "vitest run",
    "typecheck": "tsc -p shared --noEmit && tsc -p server --noEmit && tsc -p client --noEmit && tsc -p infra --noEmit"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "concurrently": "10.0.6",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
